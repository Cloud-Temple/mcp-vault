# =============================================================================
# Configuration MCP Vault — Copier en .env et adapter
#
# CONTRAT DOTENV — conventions garanties par ce fichier, vérifiées par
# tests/test_env_example_contract.py :
#   - Toute ligne non vide est SOIT un commentaire, SOIT une assignation : un nom
#     de clé, le signe égal, la valeur. Aucune autre forme, aucune ligne ambiguë.
#   - Une assignation active dont la valeur est le marqueur REQUIRED signale une
#     variable SANS défaut utilisable : le serveur refuse de démarrer tant qu'un
#     déploiement n'a pas substitué une vraie valeur. Le marqueur lui-même
#     échoue volontairement la validation, il n'est jamais une valeur valide.
#   - Une assignation précédée d'un dièse documente une variable OPTIONNELLE avec
#     son défaut ; la laisser commentée applique ce défaut.
#   - Les clés de ce fichier correspondent EXACTEMENT aux champs de Settings
#     (src/mcp_vault/config.py). Ce dernier est en mode « extra forbid » : une
#     clé inconnue portant une valeur non vide dans un .env fait échouer le
#     démarrage. Ne jamais ajouter de clé qui n'existe pas dans Settings.
#   - Chaque clé n'apparaît qu'UNE fois sous forme d'assignation, et la prose des
#     commentaires n'en contient aucune : quelle que soit la permissivité de son
#     extracteur, un consommateur externe obtient le même jeu de clés ET les
#     mêmes valeurs. Citer une variable en prose se fait sans le signe égal.
#   - Le groupe 8 est de la DOCUMENTATION seule : il ne déclare aucune variable
#     de serveur (voir l'avertissement qui l'introduit).
#
# Groupes :
#   1. Serveur MCP (transport)
#   2. WAF
#   3. Authentification
#   4. S3 (token store + vault storage sync)
#   5. OpenBao embedded
#   6. PKI interne (v0.5.x — optionnel)
#   7. Mission token enforcement (v0.6.0 — optionnel, standalone sans mcp-mission)
#   8. CLI — tokens sensibles (documentation seule, jamais dans .env)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. Serveur MCP
# ─────────────────────────────────────────────────────────────────────────────

MCP_SERVER_NAME=mcp-vault
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8030

# Niveau de log du serveur ASGI : false (défaut) = "info", true = "debug".
# MCP_SERVER_DEBUG=false

# FQDN publics par lesquels les clients MCP atteignent /mcp (séparés par virgules).
# OBLIGATOIRE en production derrière un reverse-proxy — sans cela, le SDK rejette
# le header Host public en HTTP 421 (cf. issue #3, protection anti-DNS-rebinding).
# Le loopback (localhost/127.0.0.1) est toujours autorisé automatiquement.
MCP_ALLOWED_HOSTS=vault.mcp.cloud-temple.app,my.vault.mcp.cloud-temple.app

# Origins HTTP supplémentaires (optionnel).
# "https://<fqdn>" est déjà dérivé pour chaque FQDN ci-dessus.
# MCP_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# 2. WAF
# ─────────────────────────────────────────────────────────────────────────────

WAF_PORT=8085

# ── Variables d'interpolation docker-compose — NE PAS les mettre dans ce .env ──
# docker-compose.yml interpole deux autres variables pour le service waf :
# SITE_ADDRESS (adresse d'écoute Caddy, défaut « :8085 ») et WAF_TLS_DIRECTIVE
# (directive TLS, défaut vide). Contrairement à WAF_PORT, elles ne sont PAS des
# champs de Settings. Comme ce .env est mutualisé entre l'interpolation compose et
# le conteneur, les y écrire fait échouer tout démarrage qui lit le fichier
# directement (exécution locale, tests) : clé inconnue à valeur non vide.
# Les passer à compose autrement (variable d'environnement du shell, ou fichier
# dédié via --env-file). Suivi : voir les issues du dépôt.

# ─────────────────────────────────────────────────────────────────────────────
# 3. Authentification
# ─────────────────────────────────────────────────────────────────────────────

# Clé de bootstrap pour le premier accès admin (jeton initial de l'instance Vault).
# Utilisée aussi pour déchiffrer les clés unseal OpenBao stockées sur S3.
# ⚠️  OBLIGATOIRE — le serveur REFUSE de démarrer (sys.exit) tant que cette valeur
#     n'est pas substituée : minimum 32 caractères, au moins 3 classes de
#     caractères sur 4, et la valeur par défaut du code est explicitement rejetée
#     (src/mcp_vault/openbao/crypto.py::validate_bootstrap_key).
#     Le marqueur REQUIRED ci-dessous échoue volontairement cette validation.
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_BOOTSTRAP_KEY=REQUIRED

# ── Accès SSH JIT opérateur (optionnel, vide = désactivé) ───────────────────
# Données publiques et de policy uniquement : aucun token ni clé privée.
# Le JSON est validé intégralement au démarrage. Chaque profil lie une identité
# bearer nominative, sa policy exacte, une ou plusieurs empreintes de clé SSH
# pré-enrôlée, la CA, le rôle, le principal, la cible logique et le TTL imposé.
# Pour un renderer .env strict, utiliser à la place la variante Base64 URL-safe
# du même JSON. Les deux variables sont mutuellement exclusives.
# SSH_OPERATOR_PROFILES_JSON={"bastion-prod":{"client_name":"operator-christophe","policy_id":"operator-ssh-jit","key_fingerprints":["SHA256:EMP_REINTE_BASE64"],"vault_id":"agentic-platform","role_name":"bastion-operator","principal":"ctadmin","target":"bastion-01","ttl_seconds":900}}
# SSH_OPERATOR_PROFILES_B64=BASE64_URLSAFE_SANS_RETOUR_LIGNE
# SSH_OPERATOR_JIT_MAX_CONFIG_CHARS=65536
# SSH_OPERATOR_JIT_MIN_TTL_SECONDS=60
# SSH_OPERATOR_JIT_MAX_TTL_SECONDS=900
# SSH_OPERATOR_JIT_MAX_REASON_CHARS=512
# SSH_OPERATOR_JIT_MAX_PUBLIC_KEY_CHARS=16384
# SSH_OPERATOR_JIT_MAX_PROFILES=32
# SSH_OPERATOR_JIT_MAX_BEARER_EXPIRES_DAYS=1

# ─────────────────────────────────────────────────────────────────────────────
# 4. S3 — Token Store + Vault Storage Sync
# ─────────────────────────────────────────────────────────────────────────────
# Mêmes credentials pour les deux usages (token store + sync OpenBao data).
# Compatible Dell ECS (SigV2/SigV4 hybride).

S3_ENDPOINT_URL=https://your-s3-endpoint.example.com
S3_ACCESS_KEY_ID=your_access_key_here
S3_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET_NAME=your-bucket-name
S3_REGION_NAME=fr1

# Bornes réseau des appels S3 (issue #110). Les défauts botocore (60 s + 60 s,
# retries adaptatifs) laissent un appel S3 lent bloquer le service plusieurs
# minutes. S3_MAX_ATTEMPTS = nombre TOTAL de tentatives (1 = aucun retry).
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30
S3_MAX_ATTEMPTS=2

# Plafond du pré-drain des connexions par uvicorn à l'arrêt (secondes). Au-delà,
# le coffre passe à sa séquence d'arrêt (seal + effacement des clés + sauvegarde
# finale) — évite que des connexions traînantes consomment le délai de grâce.
UVICORN_GRACEFUL_TIMEOUT=10

# Préfixe S3 pour le backup du file backend OpenBao (tar.gz périodique).
# Modifier pour isoler plusieurs instances sur le même bucket.
VAULT_S3_PREFIX=_storage

# Intervalle de sync S3 en secondes (défaut 60s).
VAULT_S3_SYNC_INTERVAL=60

# ─────────────────────────────────────────────────────────────────────────────
# 5. OpenBao embedded
# ─────────────────────────────────────────────────────────────────────────────

# Adresse interne du processus OpenBao (ne jamais exposer hors du conteneur).
OPENBAO_ADDR=http://127.0.0.1:8200

# Paramètres Shamir (1/1 = single key, adapté pour un seul opérateur).
OPENBAO_SHARES=1
OPENBAO_THRESHOLD=1

# Répertoires internes OpenBao (montés depuis les volumes Docker).
OPENBAO_DATA_DIR=/openbao/file
OPENBAO_CONFIG_DIR=/openbao/config

# ─────────────────────────────────────────────────────────────────────────────
# 6. PKI interne (v0.5.x — optionnel)
# ─────────────────────────────────────────────────────────────────────────────
# Si vide, la PKI n'est pas initialisée au démarrage.
# Activer via pki_ca_setup (outil MCP ou POST /admin/api/pki/setup).

# URL publique de base pour les CDPs ACME et le cluster path OpenBao PKI.
# Vide (défaut) = déduit du premier FQDN de MCP_ALLOWED_HOSTS (https://<fqdn>).
# Override en test Docker pour utiliser l'URL interne : http://mcp-vault:8030
# Doit être http:// ou https://.
# PKI_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 7. Mission token enforcement (v0.6.0 — optionnel)
#
# Anti-confused-deputy C18 (alignement mcp-mission/mcp-vault).
# Toutes ces variables sont OPTIONNELLES.
# Par défaut : zéro impact sur les déploiements standalone (sans mcp-mission).
# ─────────────────────────────────────────────────────────────────────────────

# ── PEP mission JWT à la porte /mcp (issue #47) ──────────────────────────────
# Mode d'authentification de l'endpoint MCP /mcp :
#   bearer     (défaut) → bearer opaque uniquement — comportement historique, ZÉRO impact.
#   jwt                 → mission_token JWT ES256 OBLIGATOIRE (bearer opaque refusé 401).
#   dual-stack          → accepte un JWT valide OU un bearer opaque valide (migration).
# En jwt/dual-stack, un JWT invalide ne retombe JAMAIS sur le bearer (401/403/503 actifs).
# ⚠️  jwt/dual-stack exigent MISSION_JWKS_URL, MCP_INSTANCE_ID, ET DÉSORMAIS AUSSI
#     ENFORCE_MISSION_TOKEN_VALIDATION à true et MISSION_STATUS_URL (fail-fast au boot,
#     issue #86 finding 1 — sans quoi le PEP /mcp est actif mais secret_consume reste
#     en mode permissif). Les mêmes exigences s'appliquent aussi en mode bearer dès
#     que ENFORCE_MISSION_TOKEN_VALIDATION est activé seul à true (#26 historique).
#
# ⚠️  RUPTURE #116 — `bearer` REFUSE désormais une requête sans jeton valide.
#     Avant, une requête sans en-tête Authorization (ou avec un jeton invalide)
#     atteignait les outils : inventaire des coffres, certificats émis, nom du
#     bucket et état des backends étaient lisibles sans authentification.
#     `bearer-anonymous` reproduit l'ancien comportement — MODE D'EXCEPTION
#     DANGEREUX, à n'utiliser que le temps de faire migrer un client sans jeton.
#     Il émet un CRITICAL au démarrage et n'exige AUCUN paramètre mission.
# MCP_AUTH_MODE=bearer

# Identifiant d'instance de CE Vault : doit figurer dans l'aud du mission_token ET
# valoir component_id[MCP_COMPONENT_KIND]. Source unique d'audience (remplace
# MISSION_TOKEN_AUD, conservé comme alias legacy). Ex : mcp-vault:prod:v1  ou  vault-prod-eu-tenant-acme.
# ⚠️  Si MCP_INSTANCE_ID et MISSION_TOKEN_AUD sont tous deux définis, ils DOIVENT être
#     identiques (le boot échoue sinon — anti config-drift).
# MCP_INSTANCE_ID=

# Type de composant pour la validation component_id[kind] == MCP_INSTANCE_ID.
# MCP_COMPONENT_KIND=vault

# Active le hard-reject JWT dans secret_consume (C18) — depuis le Lot 2 (#86), le
# validateur applique EXACTEMENT le même contrat que le PEP /mcp : mêmes claims
# requis (exp, iat, iss, aud, mission_id, jti, scope, tenant_id) et vérification de
# component_id[MCP_COMPONENT_KIND] == audience — un JWT authentique mais destiné à
# une AUTRE instance vault (aud multiple, component_id différent) est désormais
# rejeté par secret_consume, comme il l'est déjà par le PEP.
# false (défaut) → log warning si JWT invalide, continue (migration progressive).
# true           → hard-reject 401/403 sur toute violation JWT ou binding.
# ⚠️  OBLIGATOIRE (fail-fast au boot) dès que MCP_AUTH_MODE vaut jwt ou dual-stack — sinon
#     secret_consume resterait permissif malgré le PEP /mcp actif (issue #86).
#     Requiert alors MISSION_JWKS_URL, MCP_INSTANCE_ID et MISSION_STATUS_URL.
# ⚠️  Mettre à true uniquement après avoir configuré MISSION_JWKS_URL et
#     MCP_INSTANCE_ID/MISSION_TOKEN_AUD — une audience vide est désormais un rejet
#     EXPLICITE (misconfigured), plus un mode permissif silencieux (#86).
# ENFORCE_MISSION_TOKEN_VALIDATION=false

# URL du JWKS public de mcp-mission (endpoint /.well-known/jwks.json).
# Vide → validation JWT désactivée (mode standalone compatible).
# Ex : https://mcp-mission.cloud-temple.app/.well-known/jwks.json
# MISSION_JWKS_URL=

# Audience attendue dans le JWT mission_token (anti-confused-deputy).
# Doit correspondre à l'aud JWT configuré côté mcp-mission pour cette instance Vault.
# Ex : mcp-vault:prod:v1  ou  vault.mcp.cloud-temple.app
# Vide → ENFORCE_MISSION_TOKEN_VALIDATION ne peut plus être utilisé pour
# secret_consume (rejet explicite, #86) — avant le Lot 2, une audience vide
# désactivait silencieusement la vérification aud.
# MISSION_TOKEN_AUD=

# TTL du cache JWKS en secondes.
# 60s (défaut) : bon compromis révocation rapide / performance.
# MISSION_JWKS_CACHE_TTL=60

# Nombre max de refreshes JWKS par minute (rate-limit anti-DoS).
# MISSION_JWKS_MAX_REFRESH_PER_MIN=3

# Tolérance clock skew entre services, en secondes — s'applique UNIQUEMENT à `iat`
# (anti-skew horloge avancée). `exp` est TOUJOURS strict (leeway de 0), y compris pour
# secret_consume depuis le Lot 2 (#86) : un token expiré n'est jamais toléré par ce
# réglage, même de quelques secondes.
# MISSION_TOKEN_LEEWAY_SECONDS=10

# URL de vérification du statut de mission (mcp-mission status endpoint).
# Template : DOIT contenir littéralement "{mission_id}" (remplacé dynamiquement) —
# une URL statique validerait silencieusement N'IMPORTE QUELLE mission comme active
# (fail-fast au boot si absent, issue #86).
# Ex : https://mcp-mission.cloud-temple.app/api/v1/missions/{mission_id}/status
# ⚠️  OBLIGATOIRE (fail-fast au boot) dès que la validation mission_token est active
#     (MCP_AUTH_MODE à jwt ou dual-stack, OU ENFORCE_MISSION_TOKEN_VALIDATION à true seul
#     en mode bearer) — sinon une mission abortée garde l'accès jusqu'à expiration
#     du mission_token (jusqu'à 1h). Sans validation mission active du tout (aucune
#     des deux portes ci-dessus), cette variable reste optionnelle.
#     États actifs reconnus : RUNNING, WAITING_HUMAN, PAUSED (fail-close sur le reste).
# MISSION_STATUS_URL=

# TTL du cache de statut de mission en secondes (court = fail-close rapide).
# 5s (défaut) : fenêtre maximale de 5s après abort/close d'une mission.
# Bornes [0,30] validées au boot dès que MISSION_STATUS_URL est requis (0 = pas de
# cache ; >30s retarderait trop la détection d'une mission abortée).
# MISSION_STATUS_CACHE_TTL=5

# ─────────────────────────────────────────────────────────────────────────────
# 8. CLI — tokens sensibles : DOCUMENTATION SEULE, aucune variable de serveur
# ─────────────────────────────────────────────────────────────────────────────
#
# ⚠️  Ce groupe ne déclare volontairement AUCUNE variable, pas même commentée.
#
#     VAULT_WRAP_TOKEN (token de déballage OpenBao, single-use) et
#     VAULT_MISSION_TOKEN (JWT mission_token ES256) sont lus UNIQUEMENT par le
#     CLI (scripts/cli/). Ils ne figurent pas dans Settings : les écrire dans un
#     .env ferait échouer le démarrage du serveur, puisque toute clé inconnue à
#     valeur non vide y est refusée.
#
#     Ils changent à chaque opération (usage unique, TTL court) : les passer en
#     variable d'environnement inline devant la commande, jamais dans un
#     fichier — sinon ils fuitent dans l'historique de votre shell système
#     (bash, zsh…), qui conserve les lignes saisies sur disque.
#
#     Syntaxe exacte et exemples : voir scripts/README.md, section « secret
#     consume », ainsi que la section « Variables d'environnement » du README.
# ─────────────────────────────────────────────────────────────────────────────
